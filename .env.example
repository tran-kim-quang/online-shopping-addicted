# Database & Redis (host ports for local dev outside Docker)
DATABASE_URL=postgresql+asyncpg://shopqa:shopqa@localhost:5433/shopqa
REDIS_URL=redis://localhost:6380/0

# Required Fernet key (32 url-safe base64-encoded bytes).
# Generate one with:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
SECRET_KEY=REPLACE_WITH_GENERATED_FERNET_KEY

# Security: outbound SSRF controls
ALLOW_PRIVATE_LLM_HOSTS=true
ALLOW_PRIVATE_CRAWL_HOSTS=false

# LLM client settings
LLM_TIMEOUT_SECONDS=60
LLM_PROBE_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2
LLM_REGISTRY_MAX_CLIENTS=64

# Crawler settings
CRAWL_RATE_PER_SECOND=1.0
CRAWL_MAX_RETRIES=3
CRAWL_TIMEOUT_SECONDS=20
CRAWL_MAX_PRODUCTS=100
CRAWL_MAX_REVIEWS_PER_PRODUCT=200
CRAWL_CONCURRENCY=2
CRAWL_CACHE_TTL_HOURS=48

# Ingestion & Embedding settings
EMBEDDING_BACKEND=local
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_BATCH_SIZE=16
SENTIMENT_BATCH_SIZE=20
CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP_CHARS=150
HF_HOME=/models

# Job heartbeat & SSE timeouts
JOB_HEARTBEAT_INTERVAL_SECONDS=15
JOB_STALE_TIMEOUT_SECONDS=120
JOB_QUEUED_TIMEOUT_SECONDS=600
JOB_STREAM_MAX_SECONDS=3600

# Hybrid search
SEARCH_MIN_COSINE_SIMILARITY=0.6

# QA Agent
AGENT_MAX_STEPS=8
AGENT_TOOL_RESULT_MAX_CHARS=6000
AGENT_REVIEW_MAX_CHARS=500
AGENT_HISTORY_MESSAGES=10
AGENT_CRAWL_MAX_PER_TURN=1
AGENT_CRAWL_MAX_PER_SESSION=3

# Logging & CORS
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=http://localhost:3000

# nginx host port (single entry point for web + API)
HTTP_PORT=80

# Admin & cookies
# Set ADMIN_PASSWORD (>= 12 characters) to enable /[locale]/admin and shared key configuration.
ADMIN_PASSWORD=
# Set COOKIE_SECURE=true in production behind HTTPS.
COOKIE_SECURE=false
# Only set TRUST_PROXY_HEADERS=true behind a reverse proxy that overwrites X-Forwarded-For.
# docker compose already sets it for the api service, which is reachable only through nginx.
TRUST_PROXY_HEADERS=false
