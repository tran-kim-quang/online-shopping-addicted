# Single public entry point: the browser talks to one origin, nginx routes
# /api, /health and the API docs to FastAPI and everything else to Next.js.

# Defence in depth for the admin login (the API also locks an IP after 5 failures).
limit_req_zone $binary_remote_addr zone=admin_login:10m rate=10r/m;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

# Docker's embedded DNS. With `resolve`, nginx re-resolves the service names, so a
# recreated api/web container (new IP) is picked up without restarting nginx.
resolver 127.0.0.11 valid=10s ipv6=off;

upstream shopqa_api {
    zone shopqa_api 64k;
    server api:8000 resolve;
    keepalive 16;
}

upstream shopqa_web {
    zone shopqa_web 64k;
    server web:3000 resolve;
    keepalive 16;
}

# Main user-facing server: admin UI and /api/admin/* are hidden (404).
server {
    listen 80 default_server;
    server_name _;

    server_tokens off;
    client_max_body_size 2m;

    # Repeated in each server block rather than a shared include file under
    # /etc/nginx/templates, because nginx's envsubst entrypoint processes every
    # file there into /etc/nginx/conf.d/.
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;

    # Overwrite (never append) the forwarding headers so a client cannot inject a
    # fake address: the API trusts X-Forwarded-For only because nginx sets it here.
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_http_version 1.1;
    proxy_set_header Connection "";

    location ^~ /api/admin/ {
        return 404;
    }

    location ~ ^/((vi|en)/)?admin(/|$) {
        return 404;
    }

    # Server-sent events (job progress, chat streaming): no buffering, long reads.
    location ~ ^/api/(jobs/[^/]+/events|chat)$ {
        proxy_pass http://shopqa_api;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    location /api/ {
        proxy_pass http://shopqa_api;
        proxy_read_timeout 120s;
    }

    location = /health {
        proxy_pass http://shopqa_api;
    }

    location ~ ^/(docs|redoc|openapi\.json)$ {
        proxy_pass http://shopqa_api;
    }

    location / {
        proxy_pass http://shopqa_web;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}

# Dedicated admin host: serves only /admin and API endpoints needed by the admin UI.
server {
    listen 80;
    server_name ${ADMIN_HOST};

    server_tokens off;
    client_max_body_size 2m;

    # Repeated from the main server block (see note above).
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_http_version 1.1;
    proxy_set_header Connection "";

    location = / {
        return 302 /vi/admin;
    }

    location = /api/admin/login {
        limit_req zone=admin_login burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://shopqa_api;
    }

    location /api/ {
        proxy_pass http://shopqa_api;
        proxy_read_timeout 120s;
    }

    location ~ ^/((vi|en)/)?admin(/|$) {
        proxy_pass http://shopqa_web;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    location ^~ /_next/ {
        proxy_pass http://shopqa_web;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    location ~ ^/[^/]+\.(ico|png|svg|webp|jpg|txt|webmanifest)$ {
        proxy_pass http://shopqa_web;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    location / {
        return 404;
    }
}
